# SRL Zephyr devkit -- shared build environment for all SRL Zephyr repos.
#
# Holds the full Zephyr build toolchain (apt deps, Zephyr SDK, Python venv,
# west) needed to cross-compile SRL flight/embedded software for hardware
# targets (e.g. nucleo_h723zg, phoenix_pcb) via the Zephyr SDK's
# arm-zephyr-eabi toolchain. NO repository is copied into the image -- each
# working repo is bind-mounted at runtime under /workspaces/<name> (see the
# `srl` host launcher and docker-compose.yml), so host edits are picked up
# immediately with no `docker cp` step.
#
# Build (from the devkit root, so the build context includes bin/ and docker/):
#   docker compose -f docker/docker-compose.yml build
# or:
#   docker build -f docker/Dockerfile.dev -t srl-zephyr-devkit .

FROM debian:13.1

# Space-separated Zephyr SDK versions to install side by side. Different Zephyr
# releases require different SDKs (v4.0.0 wants 0.17.0; main wants 1.0.1, and the
# 0.x vs 1.x SDKs are mutually incompatible), so the image ships both and each
# repo's build auto-selects the SDK compatible with its own `zephyr/` tree.
ARG ZSDK_VERSIONS="0.17.0 1.0.1"
# Space-separated Zephyr versions whose Python build requirements get baked in --
# one per distinct `zephyr` revision across the repos this image serves (see each
# repo's west.yaml / srl.yml). requirements-base.txt is stable within a minor
# release; installed newest-last so the tip's pins win on any overlap.
ARG ZEPHYR_VERSIONS="v4.0.0 main"
# Populated automatically by BuildKit (Docker's default builder) to "amd64"
# or "arm64" depending on the host/target platform.
ARG TARGETARCH

# Build deps for cross-compiling Zephyr firmware (see any repo's README).
# Trimmed to what cross-compiling needs -- omits libsdl2-dev and
# gcc-multilib/g++-multilib, which are only for the native_sim host target.
RUN apt update && \
    apt install -y --no-install-recommends git cmake ninja-build gperf \
      ccache dfu-util device-tree-compiler wget \
      python3-dev python3-pip python3-setuptools python3-tk python3-wheel python3.13-venv xz-utils file \
      make gcc build-essential libmagic1 && \
    rm -rf /var/lib/apt/lists/*

# Space-separated Zephyr SDK toolchains to install. We cross-compile only for
# ARM Cortex-M targets (nucleo_h723zg, phoenix_pcb), so we install just
# arm-zephyr-eabi. Override at build time if a repo adds a non-ARM target, e.g.
#   --build-arg ZSDK_TOOLCHAINS="arm-zephyr-eabi riscv64-zephyr-elf"
ARG ZSDK_TOOLCHAINS="arm-zephyr-eabi"

# Install the Zephyr SDK from the *minimal* bundle (~45 MB) plus only the
# toolchain(s) we actually build for (~115 MB for ARM), instead of the full
# SDK (~1.7 GB compressed, ~5 GB extracted -- every toolchain: riscv, xtensa,
# x86, ...). This keeps the image small and, crucially, keeps the multi-arch CI
# build (arm64 runs QEMU-emulated on an amd64 runner) from exhausting the
# runner's ~14 GB disk or spending minutes just xz-decompressing toolchains we
# never use. setup.sh downloads/verifies each toolchain and registers the
# Zephyr CMake package.
RUN case "$TARGETARCH" in \
      amd64) ZSDK_ARCH=linux-x86_64 ;; \
      arm64) ZSDK_ARCH=linux-aarch64 ;; \
      *) echo "Unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac && \
    mkdir -p /opt && cd /opt && \
    for ZSDK_VERSION in ${ZSDK_VERSIONS}; do \
      BUNDLE=zephyr-sdk-${ZSDK_VERSION}_${ZSDK_ARCH}_minimal.tar.xz && \
      wget -q https://github.com/zephyrproject-rtos/sdk-ng/releases/download/v${ZSDK_VERSION}/${BUNDLE} && \
      wget -qO - https://github.com/zephyrproject-rtos/sdk-ng/releases/download/v${ZSDK_VERSION}/sha256.sum | shasum --check --ignore-missing && \
      tar xf ${BUNDLE} && \
      rm ${BUNDLE} && \
      ( cd zephyr-sdk-${ZSDK_VERSION} && \
        ./setup.sh -c $(for t in ${ZSDK_TOOLCHAINS}; do printf ' -t %s' "$t"; done) ); \
    done

# Deliberately NOT setting ZEPHYR_SDK_INSTALL_DIR: that pins the build to one SDK
# dir. Left unset, Zephyr's FindZephyr-sdk enumerates every SDK under /opt (and
# the CMake package registry each setup.sh -c wrote) and picks the one whose
# Zephyr-sdkConfig declares itself compatible with the tree being built.

# Python venv with west + the tool's own deps (PyYAML), pinned via
# requirements.txt.
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
# The ENV above covers non-login shells, but a login shell (bash -l) sources
# /etc/profile, which rebuilds PATH from scratch and would drop the venv --
# leaving `west`/`python` missing. Re-add the venv for login shells too.
RUN printf 'PATH="/opt/venv/bin:$PATH"\n' > /etc/profile.d/venv.sh
COPY docker/requirements.txt /tmp/requirements.txt
RUN pip install --upgrade pip && \
    pip install -r /tmp/requirements.txt && \
    rm /tmp/requirements.txt

# Zephyr's build scripts need their own Python deps (pyelftools, PyYAML, ...);
# without these the build fails with "ModuleNotFoundError: No module named
# 'elftools'". No repo is copied in, so fetch the pinned Zephyr's
# self-contained requirements-base.txt and install it into the venv.
RUN for ZV in ${ZEPHYR_VERSIONS}; do \
      wget -O /tmp/zephyr-requirements-base.txt \
        https://raw.githubusercontent.com/zephyrproject-rtos/zephyr/${ZV}/scripts/requirements-base.txt && \
      pip install -r /tmp/zephyr-requirements-base.txt && \
      rm /tmp/zephyr-requirements-base.txt; \
    done

# Record what this image ships, so the `srl` tool can note a repo whose pinned
# Zephyr version isn't among the ones the image was built for.
ENV SRL_IMAGE_ZEPHYR=${ZEPHYR_VERSIONS}
ENV SRL_IMAGE_ZSDK=${ZSDK_VERSIONS}

COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
# `srl` is the multi-repo build tool (successor to phx). It discovers repos
# mounted under /workspaces via their srl.yml and drives west for each.
COPY docker/srl /usr/local/bin/srl
RUN chmod +x /usr/local/bin/entrypoint.sh /usr/local/bin/srl

# Repos are bind-mounted here at runtime, each at /workspaces/<name>.
WORKDIR /workspaces

ENTRYPOINT ["entrypoint.sh"]
CMD ["bash"]
